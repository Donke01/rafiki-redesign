<?xml version="1.0" encoding="utf-8"?>
<!-- RAFIKI Pin widget, medium (4×2): visits due, urgent repairs, work for you, and two quick actions. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" android:id="@+id/w_root"
    android:layout_width="match_parent" android:layout_height="match_parent" android:orientation="vertical"
    android:background="@drawable/w_bg" android:paddingStart="12dp" android:paddingEnd="12dp" android:paddingTop="10dp" android:paddingBottom="10dp" android:clipToOutline="true">
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:gravity="center_vertical">
        <ImageView android:id="@+id/w_drop" android:layout_width="21dp" android:layout_height="24dp" android:src="@drawable/w_drop" android:importantForAccessibility="no" />
        <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:layout_marginStart="8dp" android:text="@string/w_name"
            android:textColor="@color/w_ink" android:textSize="15sp" android:fontFamily="sans-serif-black" android:maxLines="1" android:letterSpacing="-0.01" />
        <TextView android:id="@+id/w_time" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text=""
            android:textColor="@color/w_muted" android:textSize="11sp" android:maxLines="1" />
    </LinearLayout>
    <LinearLayout android:id="@+id/w_tiles" android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:orientation="horizontal" android:layout_marginTop="6dp">
        <LinearLayout android:id="@+id/w_tile_due" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:orientation="vertical" android:gravity="center_vertical"
            android:background="@drawable/w_tile_teal" android:paddingStart="10dp" android:paddingEnd="6dp" android:paddingTop="3dp" android:paddingBottom="3dp" >
            <TextView android:id="@+id/w_n_due" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="3"
                android:textColor="@color/w_teal" android:textSize="19sp" android:fontFamily="sans-serif-black" android:includeFontPadding="false" />
            <TextView android:id="@+id/w_l_due" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/w_due"
                android:textColor="@color/w_ink" android:textSize="11sp" android:fontFamily="sans-serif-medium" android:maxLines="1" android:ellipsize="end" android:layout_marginTop="2dp" />
        </LinearLayout>
        <LinearLayout android:id="@+id/w_tile_urgent" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:orientation="vertical" android:gravity="center_vertical"
            android:background="@drawable/w_tile_amber" android:paddingStart="10dp" android:paddingEnd="6dp" android:paddingTop="3dp" android:paddingBottom="3dp" android:layout_marginStart="6dp">
            <TextView android:id="@+id/w_n_urgent" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="1"
                android:textColor="@color/w_amber" android:textSize="19sp" android:fontFamily="sans-serif-black" android:includeFontPadding="false" />
            <TextView android:id="@+id/w_l_urgent" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/w_urgent"
                android:textColor="@color/w_ink" android:textSize="11sp" android:fontFamily="sans-serif-medium" android:maxLines="1" android:ellipsize="end" android:layout_marginTop="2dp" />
        </LinearLayout>
        <LinearLayout android:id="@+id/w_tile_yours" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:orientation="vertical" android:gravity="center_vertical"
            android:background="@drawable/w_tile_coral" android:paddingStart="10dp" android:paddingEnd="6dp" android:paddingTop="3dp" android:paddingBottom="3dp" android:layout_marginStart="6dp">
            <TextView android:id="@+id/w_n_yours" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="2"
                android:textColor="@color/w_coral" android:textSize="19sp" android:fontFamily="sans-serif-black" android:includeFontPadding="false" />
            <TextView android:id="@+id/w_l_yours" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/w_yours"
                android:textColor="@color/w_ink" android:textSize="11sp" android:fontFamily="sans-serif-medium" android:maxLines="1" android:ellipsize="end" android:layout_marginTop="2dp" />
        </LinearLayout>
    </LinearLayout>
    <TextView android:id="@+id/w_msg" android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:gravity="center_vertical" android:layout_marginTop="6dp" android:visibility="gone"
        android:textColor="@color/w_ink" android:textSize="13sp" android:fontFamily="sans-serif-medium" android:maxLines="2" android:ellipsize="end" />
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:layout_marginTop="7dp">
        <LinearLayout android:id="@+id/w_go_near" android:layout_width="0dp" android:layout_height="34dp" android:layout_weight="1" android:orientation="horizontal"
            android:gravity="center" android:background="@drawable/w_btn_green" android:paddingStart="8dp" android:paddingEnd="8dp" android:contentDescription="@string/w_visit">
            <ImageView android:layout_width="16dp" android:layout_height="16dp" android:src="@drawable/w_ic_near" android:importantForAccessibility="no" />
            <TextView android:id="@+id/w_go_near_t" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginStart="6dp" android:text="@string/w_visit"
                android:textColor="#FFFFFFFF" android:textSize="12.5sp" android:fontFamily="sans-serif-black" android:maxLines="1" android:ellipsize="end" />
        </LinearLayout>
        <LinearLayout android:id="@+id/w_go_pin" android:layout_width="0dp" android:layout_height="34dp" android:layout_weight="1" android:layout_marginStart="8dp" android:orientation="horizontal"
            android:gravity="center" android:background="@drawable/w_btn_blue" android:paddingStart="8dp" android:paddingEnd="8dp" android:contentDescription="@string/w_pin">
            <ImageView android:layout_width="16dp" android:layout_height="16dp" android:src="@drawable/w_ic_pin" android:importantForAccessibility="no" />
            <TextView android:id="@+id/w_go_pin_t" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginStart="6dp" android:text="@string/w_pin"
                android:textColor="#FFFFFFFF" android:textSize="12.5sp" android:fontFamily="sans-serif-black" android:maxLines="1" android:ellipsize="end" />
        </LinearLayout>
    </LinearLayout>
</LinearLayout>
