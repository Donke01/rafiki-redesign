{
  "name": "Rafiki Pin",
  "short_name": "Rafiki Pin",
  "description": "Rafiki Outreach field app: pin project locations, report site visits, track repairs and add new sites.",
  "start_url": "/pin",
  "scope": "/pin",
  "display": "standalone",
  "background_color": "#EEF0F2",
  "theme_color": "#076DB1",
  "icons": [
    {
      "src": "/img/pin/icon-192.png",
      "sizes": "192x192",
      "type": "image/png"
    },
    {
      "src": "/img/pin/icon-512.png",
      "sizes": "512x512",
      "type": "image/png"
    },
    {
      "src": "/img/pin/icon-maskable-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "maskable"
    },
    {
      "src": "/apple-touch-icon.png",
      "sizes": "180x180",
      "type": "image/png"
    }
  ],
  "id": "/pin"
}
