/*
  Content-Security-Policy: default-src 'self'; script-src 'self' 'unsafe-inline' 'unsafe-eval' https://cdn.jsdelivr.net https://challenges.cloudflare.com; frame-src https://challenges.cloudflare.com; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src 'self' https://fonts.gstatic.com data:; img-src 'self' data: blob: https:; media-src 'self' blob: https:; connect-src 'self' https:
  X-Content-Type-Options: nosniff
/img/*
  Cache-Control: public, max-age=86400
/support.js
  Cache-Control: public, max-age=3600
/feed.js
  Cache-Control: public, max-age=3600
/motion.js
  Cache-Control: public, max-age=3600
/pin
  X-Robots-Tag: noindex, nofollow
/vendor/*
  Cache-Control: public, max-age=604800
/pin-sw.js
  Cache-Control: no-cache
  Service-Worker-Allowed: /pin

/.well-known/assetlinks.json
  Content-Type: application/json
  Access-Control-Allow-Origin: *

/app/*.apk
  Content-Type: application/vnd.android.package-archive
  Content-Disposition: attachment; filename="RAFIKI-Pin.apk"
